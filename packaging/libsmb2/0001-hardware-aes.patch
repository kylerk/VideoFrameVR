From: VideoFrameVR contributors
Date: Wed, 28 Oct 2026
Subject: [PATCH] Reuse AES round keys and accelerate blocks on ARM64 and x86_64

Base: libsmb2-6.3, 2bcb014b23a8c8cccf534eea8bda2fe5df453cfd

Expand AES-128 keys once per CMAC/CCM operation rather than once per block.
Share the CCM schedule between authentication and counter-mode encryption.
Keep the CMAC/CCM algorithms and tag verification unchanged.

Select ARMv8 Crypto Extensions on Linux using AT_HWCAP/HWCAP_AES and AES-NI
on x86_64 using __builtin_cpu_supports("aes"). Intrinsics are confined to
target-attributed functions; other CPUs and compilers keep the bundled
software cipher. No new dependency or global architecture flags are needed.

The AES changes retain the original public-domain grant. Changes to the
LGPL files are LGPL-2.1-or-later, with dated modification notices in each file.

---
diff --git a/lib/aes.c b/lib/aes.c
index ebe841a..c8a8524 100644
--- a/lib/aes.c
+++ b/lib/aes.c
@@ -1,5 +1,7 @@
 /* From https://github.com/bitdust/tiny-AES128-C
  * Licenced as Public Domain
+ * Modified 2026-10-28: reusable AES-128 encryption keys and CPU dispatch.
+ * These modifications are also dedicated to the public domain.
  */
 
 /*
@@ -41,6 +43,16 @@ NOTE:   String length must be evenly divisible by 16byte (str_len % 16 == 0)
 #include <string.h> // CBC mode, for memset
 #include "aes.h"
 
+#if (defined(__GNUC__) || defined(__clang__)) && defined(__x86_64__)
+#include <wmmintrin.h>
+#define AES128_X86 1
+#elif (defined(__GNUC__) || defined(__clang__)) && defined(__aarch64__) && defined(__linux__)
+#include <arm_neon.h>
+#include <sys/auxv.h>
+#include <asm/hwcap.h>
+#define AES128_ARM 1
+#endif
+
 
 /*****************************************************************************/
 /* Defines:                                                                  */
@@ -210,7 +222,7 @@ static void KeyExpansion(const uint8_t* Key, uint8_t* roundKey)
 
 // This function adds the round key to state.
 // The round key is added to the state by an XOR function.
-static void AddRoundKey(uint8_t* roundKey, state_t* state, uint8_t round)
+static void AddRoundKey(const uint8_t* roundKey, state_t* state, uint8_t round)
 {
   uint8_t i,j;
   for(i=0;i<4;++i)
@@ -374,7 +386,7 @@ static void InvShiftRows(state_t* state)
 
 
 // Cipher is the main function that encrypts the PlainText.
-static void Cipher(uint8_t* roundKey, state_t* state)
+static void Cipher(const uint8_t* roundKey, state_t* state)
 {
   uint8_t round = 0;
 
@@ -440,19 +452,73 @@ static void BlockCopy(uint8_t* output, uint8_t* input)
 /*****************************************************************************/
 #if defined(ECB) && ECB
 
+static void AES128_encrypt_software(const uint8_t* roundKey,
+                                    const uint8_t* input, uint8_t* output)
+{
+  memmove(output, input, KEYLEN);
+  Cipher(roundKey, (state_t*)output);
+}
 
-void AES128_ECB_encrypt(uint8_t* input, const uint8_t* key, uint8_t* output)
+#ifdef AES128_X86
+__attribute__((target("aes,sse2")))
+static void AES128_encrypt_hardware(const uint8_t* roundKey,
+                                    const uint8_t* input, uint8_t* output)
 {
-  // The array that stores the round keys.
-  uint8_t roundKey[176];
+  __m128i state = _mm_loadu_si128((const __m128i*)input);
+  int round;
 
-  // Copy input to output, and work in-memory on output
-  BlockCopy(output, input);
+  state = _mm_xor_si128(state, _mm_loadu_si128((const __m128i*)roundKey));
+  for (round = 1; round < Nr; round++) {
+    state = _mm_aesenc_si128(state,
+                            _mm_loadu_si128((const __m128i*)(roundKey + round * 16)));
+  }
+  state = _mm_aesenclast_si128(state,
+                              _mm_loadu_si128((const __m128i*)(roundKey + Nr * 16)));
+  _mm_storeu_si128((__m128i*)output, state);
+}
+#elif defined(AES128_ARM)
+__attribute__((target("+crypto")))
+static void AES128_encrypt_hardware(const uint8_t* roundKey,
+                                    const uint8_t* input, uint8_t* output)
+{
+  uint8x16_t state = vld1q_u8(input);
+  int round;
 
-  KeyExpansion(key, roundKey);
+  /* AESE adds the round key before SubBytes/ShiftRows, unlike AES-NI. */
+  for (round = 0; round < Nr - 1; round++) {
+    state = vaesmcq_u8(vaeseq_u8(state, vld1q_u8(roundKey + round * 16)));
+  }
+  state = vaeseq_u8(state, vld1q_u8(roundKey + (Nr - 1) * 16));
+  vst1q_u8(output, veorq_u8(state, vld1q_u8(roundKey + Nr * 16)));
+}
+#endif
 
-  // The next function call encrypts the PlainText with the Key using AES algorithm.
-  Cipher(roundKey, (state_t*)output);
+void AES128_init(struct AES128_context* ctx, const uint8_t* key)
+{
+  KeyExpansion(key, ctx->roundKey);
+  ctx->encrypt = AES128_encrypt_software;
+#ifdef AES128_X86
+  if (__builtin_cpu_supports("aes")) {
+    ctx->encrypt = AES128_encrypt_hardware;
+  }
+#elif defined(AES128_ARM)
+  if (getauxval(AT_HWCAP) & HWCAP_AES) {
+    ctx->encrypt = AES128_encrypt_hardware;
+  }
+#endif
+}
+
+void AES128_encrypt_block(const struct AES128_context* ctx,
+                          const uint8_t* input, uint8_t* output)
+{
+  ctx->encrypt(ctx->roundKey, input, output);
+}
+
+void AES128_ECB_encrypt(uint8_t* input, const uint8_t* key, uint8_t* output)
+{
+  struct AES128_context ctx;
+  AES128_init(&ctx, key);
+  AES128_encrypt_block(&ctx, input, output);
 }
 
 void AES128_ECB_decrypt(uint8_t* input, const uint8_t* key, uint8_t *output)
diff --git a/lib/aes.h b/lib/aes.h
index 660edc3..b081f37 100644
--- a/lib/aes.h
+++ b/lib/aes.h
@@ -1,5 +1,7 @@
 /* From https://github.com/bitdust/tiny-AES128-C
  * Licenced as Public Domain
+ * Modified 2026-10-28: reusable AES-128 encryption keys and CPU dispatch.
+ * These modifications are also dedicated to the public domain.
  */
 
 #ifndef _AES_H_
@@ -31,6 +33,15 @@
 
 #if defined(ECB) && ECB
 
+struct AES128_context {
+  uint8_t roundKey[176];
+  void (*encrypt)(const uint8_t*, const uint8_t*, uint8_t*);
+};
+
+void AES128_init(struct AES128_context* ctx, const uint8_t* key);
+void AES128_encrypt_block(const struct AES128_context* ctx,
+                          const uint8_t* input, uint8_t* output);
+
 void AES128_ECB_encrypt(uint8_t* input, const uint8_t* key, uint8_t *output);
 void AES128_ECB_decrypt(uint8_t* input, const uint8_t* key, uint8_t *output);
 
