    the Free Software Foundation; either version 2.1 of the License, or
@@ -62,7 +65,7 @@ static inline void bxory(unsigned char *b, unsigned char *y, size_t num)
         }
 }
 
-static void ccm_generate_T(unsigned char *key,
+static void ccm_generate_T(const struct AES128_context *ctx,
                            unsigned char *nonce, size_t nlen,
                            unsigned char *aad, size_t alen,
                            unsigned char *p, size_t plen,
@@ -72,7 +75,7 @@ static void ccm_generate_T(unsigned char *key,
         uint16_t l;
 
         aes_ccm_generate_b0(nonce, nlen, alen, plen, mlen, &b[0]);
-        AES128_ECB_encrypt(b, key, y);
+        AES128_encrypt_block(ctx, b, y);
 
         /* Create Aad */
         if (alen) {
@@ -87,7 +90,7 @@ static void ccm_generate_T(unsigned char *key,
                 alen -= l;
 
                 bxory(b, y, 16);
-                AES128_ECB_encrypt(b, key, y);
+                AES128_encrypt_block(ctx, b, y);
 
                 while (alen) {
                         memset(b, 0, 16);
@@ -97,7 +100,7 @@ static void ccm_generate_T(unsigned char *key,
                         alen -= l;
 
                         bxory(b, y, 16);
-                        AES128_ECB_encrypt(b, key, y);
+                        AES128_encrypt_block(ctx, b, y);
                 }
         }
 
@@ -110,13 +113,13 @@ static void ccm_generate_T(unsigned char *key,
                 plen -= l;
 
                 bxory(b, y, 16);
-                AES128_ECB_encrypt(b, key, y);
+                AES128_encrypt_block(ctx, b, y);
         }
 
         memcpy(m, y, mlen);
 }
 
-static void ccm_generate_s(unsigned char *key, unsigned char *nonce, size_t nlen,
+static void ccm_generate_s(const struct AES128_context *ctx, unsigned char *nonce, size_t nlen,
                            size_t plen, int i, unsigned char *s)
 {
         uint32_t l;
@@ -129,10 +132,10 @@ static void ccm_generate_s(unsigned char *key, unsigned char *nonce, size_t nlen
 
         memcpy(&s[1], nonce, nlen);
 
-        AES128_ECB_encrypt(s, key, s);
+        AES128_encrypt_block(ctx, s, s);
 }
 
-static void aes_ccm_crypt(unsigned char *key,
+static void aes_ccm_crypt(const struct AES128_context *ctx,
                           unsigned char *nonce, size_t nlen,
                           unsigned char *p, size_t plen)
 {
@@ -143,7 +146,7 @@ static void aes_ccm_crypt(unsigned char *key,
         j = 0;
         while (plen) {
                 l = (plen > 16) ? 16 : plen;
-                ccm_generate_s(key, nonce, nlen, plen, j + 1, &s[0]);
+                ccm_generate_s(ctx, nonce, nlen, plen, j + 1, &s[0]);
                 bxory(&p[j * 16], &s[0], l);
 
                 j++;
@@ -157,13 +160,15 @@ void aes128ccm_encrypt(unsigned char *key,
                        unsigned char *p, size_t plen,
                        unsigned char *m, size_t mlen)
 {
+        struct AES128_context ctx;
         unsigned char s[16] _U_;
 
-        ccm_generate_T(key, nonce, nlen, aad, alen, p, plen, m, mlen);
-        ccm_generate_s(key, nonce, nlen, plen, 0, &s[0]);
+        AES128_init(&ctx, key);
+        ccm_generate_T(&ctx, nonce, nlen, aad, alen, p, plen, m, mlen);
+        ccm_generate_s(&ctx, nonce, nlen, plen, 0, &s[0]);
         bxory(m, &s[0], mlen);
 
-        aes_ccm_crypt(key, nonce, nlen, p, plen);
+        aes_ccm_crypt(&ctx, nonce, nlen, p, plen);
 }
 
 int aes128ccm_decrypt(unsigned char *key,
@@ -172,13 +177,15 @@ int aes128ccm_decrypt(unsigned char *key,
                       unsigned char *p, size_t plen,
                       unsigned char *m, size_t mlen)
 {
+        struct AES128_context ctx;
         unsigned char s[16] _U_;
         unsigned char tmp[16];
 
-        aes_ccm_crypt(key, nonce, nlen, p, plen);
+        AES128_init(&ctx, key);
+        aes_ccm_crypt(&ctx, nonce, nlen, p, plen);
 
-        ccm_generate_T(key, nonce, nlen, aad, alen, p, plen, tmp, mlen);
-        ccm_generate_s(key, nonce, nlen, plen, 0, &s[0]);
+        ccm_generate_T(&ctx, nonce, nlen, aad, alen, p, plen, tmp, mlen);
+        ccm_generate_s(&ctx, nonce, nlen, plen, 0, &s[0]);
         bxory(tmp, &s[0], mlen);
 
         return memcmp(tmp, m, mlen);
