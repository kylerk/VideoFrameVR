# Size the Iris decoder's capture pool from the driver's own minimum.
--- a/libavcodec/v4l2_m2m.h
+++ b/libavcodec/v4l2_m2m.h
@@ -137,6 +137,7 @@
 
     int num_output_buffers;
     int num_capture_buffers;
+    int capture_spare;
     int capture_ubwc;
     int capture_10bit;
     enum AVPixelFormat source_pix_fmt;
--- a/libavcodec/v4l2_m2m_dec.c
+++ b/libavcodec/v4l2_m2m_dec.c
@@ -1362,6 +1362,8 @@
     V4L_M2M_DEFAULT_OPTS,
     { "num_capture_buffers", "Number of buffers in the capture context",
         OFFSET(num_capture_buffers), AV_OPT_TYPE_INT, {.i64 = 20}, 2, INT_MAX, FLAGS },
+    { "capture_spare", "Capture buffers beyond the driver's minimum; replaces num_capture_buffers (-1: off)",
+        OFFSET(capture_spare), AV_OPT_TYPE_INT, {.i64 = -1}, -1, 32, FLAGS },
     { "capture_ubwc", "Use Qualcomm compressed NV12 capture for DRM output",
         OFFSET(capture_ubwc), AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, FLAGS },
     { "pixel_format", "Pixel format to be used by the decoder", OFFSET(pix_fmt), AV_OPT_TYPE_PIXEL_FMT, {.i64 = AV_PIX_FMT_NONE}, AV_PIX_FMT_NONE, AV_PIX_FMT_NB, FLAGS },
--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -1245,8 +1245,17 @@
 
     av_assert0(ctx->bufrefs == NULL);
 
+    // With capture_spare, a decoder's capture pool is the driver's minimum
+    // (what it raises a request of one to) plus the caller's spare: frames
+    // the stream keeps back for reordering and frames held until shown. The
+    // driver's minimum is the same for every stream, so a fixed total
+    // deadlocks streams that reorder more.
+    const int spare = !V4L2_TYPE_IS_OUTPUT(ctx->type) && s->avctx &&
+                      av_codec_is_decoder(s->avctx->codec) ?
+                      ((const V4L2m2mPriv *)s->priv)->capture_spare : -1;
+
     memset(&req, 0, sizeof(req));
-    req.count = req_buffers;
+    req.count = spare >= 0 ? 1 : req_buffers;
     req.memory = mem;
     req.type = ctx->type;
     while ((ret = ioctl(s->fd, VIDIOC_REQBUFS, &req)) == -1) {
@@ -1257,6 +1266,22 @@
         }
     }
 
+    if (spare > 0) {
+        // Requested again at the full size: Iris raises VIDIOC_CREATE_BUFS
+        // counts to its minimum too, and its stream then fails.
+        const unsigned int needed = req.count;
+        req.count = needed + spare;
+        while ((ret = ioctl(s->fd, VIDIOC_REQBUFS, &req)) == -1) {
+            if (errno != EINTR) {
+                ret = AVERROR(errno);
+                av_log(logger(ctx), AV_LOG_ERROR, "%s VIDIOC_REQBUFS failed: %s\n", ctx->name, av_err2str(ret));
+                return ret;
+            }
+        }
+        av_log(logger(ctx), AV_LOG_INFO, "%s: driver needs %u buffers, %u in all\n",
+               ctx->name, needed, req.count);
+    }
+
     ctx->num_buffers = req.count;
     ctx->bufrefs = av_mallocz(ctx->num_buffers * sizeof(*ctx->bufrefs));
     if (!ctx->bufrefs) {
